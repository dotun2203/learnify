# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (host is "db" inside Docker, "localhost" outside) ---
POSTGRES_DB=learnify
POSTGRES_USER=learnify
POSTGRES_PASSWORD=learnify
DATABASE_URL=postgres://learnify:learnify@db:5432/learnify

# --- Redis: queue and cache are separate instances ---
CELERY_BROKER_URL=redis://redis-queue:6379/0
REDIS_CACHE_URL=redis://redis-cache:6379/0

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Integrations (fill in later) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=

# --- Email (dev prints to console; these are used in prod) ---
DEFAULT_FROM_EMAIL=Learnify <no-reply@learnify.local>
SUPPORT_EMAIL=support@learnify.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
