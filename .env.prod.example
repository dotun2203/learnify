# Template for the production env (Coolify). Copy to .env.prod and fill in.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Database (never change these after the first successful deploy) ---
# Password: letters and numbers only, it goes inside DATABASE_URL.
POSTGRES_DB=learnify
POSTGRES_USER=learnify
POSTGRES_PASSWORD=

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,localhost
SECURE_SSL_REDIRECT=False
LOG_LEVEL=INFO

# --- Frontend ---
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# --- Email via Resend SMTP (user is literally "resend", password is your API key) ---
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Learnify <no-reply@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com

# --- Integrations (optional) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=
